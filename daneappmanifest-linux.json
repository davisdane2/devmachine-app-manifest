{
  "name": "Dane Dev Machine Manifest (Linux Mint)",
  "version": 2,
  "_note": "apt-based starter manifest for Linux Mint. Host this at daneappmanifest-linux.json in the devmachine-app-manifest repo. apt needs root, so install scripts go through pkexec — each install pops one polkit password dialog. Detection is detectCommand-only on Linux ('dpkg -s' for apt packages); the /Applications and brew/mas signals return empty here. Apps with no apt package are manual entries or direct .deb downloads (gdebi opens them on Mint).",
  "apps": [
    {
      "id": "zsh",
      "name": "zsh",
      "category": "System & Runtime",
      "manager": "apt",
      "packageId": "zsh",
      "source": "apt",
      "installScript": "pkexec apt-get install -y zsh",
      "url": null,
      "recommendedKeep": true,
      "notes": "Dane's preferred shell. The app itself doesn't need it (it uses bash on Linux); to make it the login shell afterwards: chsh -s $(which zsh).",
      "detectCommand": "dpkg -s zsh 2>/dev/null | grep -q 'ok installed'"
    },
    {
      "id": "git",
      "name": "git",
      "category": "Dev Tools",
      "manager": "apt",
      "packageId": "git",
      "source": "apt",
      "installScript": "pkexec apt-get install -y git",
      "url": null,
      "recommendedKeep": true,
      "notes": "",
      "detectCommand": "dpkg -s git 2>/dev/null | grep -q 'ok installed'"
    },
    {
      "id": "github-cli",
      "name": "GitHub CLI",
      "category": "Dev Tools",
      "manager": "apt",
      "packageId": "gh",
      "source": "apt",
      "installScript": "pkexec apt-get install -y gh",
      "url": null,
      "recommendedKeep": true,
      "notes": "",
      "detectCommand": "dpkg -s gh 2>/dev/null | grep -q 'ok installed'"
    },
    {
      "id": "build-essential",
      "name": "Build Essential",
      "category": "Dev Tools",
      "manager": "apt",
      "packageId": "build-essential",
      "source": "apt",
      "installScript": "pkexec apt-get install -y build-essential",
      "url": null,
      "recommendedKeep": true,
      "notes": "gcc/g++/make toolchain — the Linux stand-in for VS Build Tools / vcredist.",
      "detectCommand": "dpkg -s build-essential 2>/dev/null | grep -q 'ok installed'"
    },
    {
      "id": "python-3",
      "name": "Python 3",
      "category": "System & Runtime",
      "manager": "apt",
      "packageId": "python3",
      "source": "apt",
      "installScript": "pkexec apt-get install -y python3 python3-pip python3-venv",
      "url": null,
      "recommendedKeep": true,
      "notes": "Preinstalled on Mint; this adds pip and venv alongside.",
      "detectCommand": "dpkg -s python3-pip 2>/dev/null | grep -q 'ok installed'"
    },
    {
      "id": "openjdk-17",
      "name": "OpenJDK 17",
      "category": "System & Runtime",
      "manager": "apt",
      "packageId": "openjdk-17-jdk",
      "source": "apt",
      "installScript": "pkexec apt-get install -y openjdk-17-jdk",
      "url": null,
      "recommendedKeep": true,
      "notes": "Stand-in for the Windows manifest's Oracle JDK 17.",
      "detectCommand": "dpkg -s openjdk-17-jdk 2>/dev/null | grep -q 'ok installed'"
    },
    {
      "id": "dotnet-sdk",
      "name": ".NET SDK",
      "category": "System & Runtime",
      "manager": "apt",
      "packageId": "dotnet-sdk-8.0",
      "source": "apt",
      "installScript": "pkexec apt-get install -y dotnet-sdk-8.0",
      "url": "https://learn.microsoft.com/dotnet/core/install/linux-ubuntu",
      "recommendedKeep": true,
      "notes": "Ubuntu/Mint repos carry 8.0 LTS; .NET 10 needs Microsoft's package feed.",
      "detectCommand": "dpkg -s dotnet-sdk-8.0 2>/dev/null | grep -q 'ok installed'"
    },
    {
      "id": "docker",
      "name": "Docker Engine",
      "category": "Dev Tools",
      "manager": "apt",
      "packageId": "docker.io",
      "source": "apt",
      "installScript": "pkexec apt-get install -y docker.io docker-compose-v2",
      "url": "https://docs.docker.com/engine/install/",
      "recommendedKeep": true,
      "notes": "Engine + compose, no Docker Desktop. After install: sudo usermod -aG docker $USER, then log out/in.",
      "detectCommand": "dpkg -s docker.io 2>/dev/null | grep -q 'ok installed'"
    },
    {
      "id": "nvm",
      "name": "NVM (Node Version Manager)",
      "category": "System & Runtime",
      "manager": "script",
      "packageId": "nvm",
      "source": "github",
      "installScript": "curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.3/install.sh | bash",
      "url": "https://github.com/nvm-sh/nvm",
      "recommendedKeep": true,
      "notes": "Stand-in for NVM for Windows. User-level install, no sudo.",
      "detectCommand": "[ -s \"$HOME/.nvm/nvm.sh\" ]"
    },
    {
      "id": "pnpm",
      "name": "pnpm",
      "category": "Dev Tools",
      "manager": "script",
      "packageId": "pnpm",
      "source": "script",
      "installScript": "curl -fsSL https://get.pnpm.io/install.sh | sh -",
      "url": "https://pnpm.io/installation",
      "recommendedKeep": true,
      "notes": "User-level standalone install, no sudo.",
      "detectCommand": "command -v pnpm || [ -x \"$HOME/.local/share/pnpm/pnpm\" ]"
    },
    {
      "id": "powershell",
      "name": "PowerShell",
      "category": "System & Runtime",
      "manager": "manual",
      "packageId": "powershell",
      "source": "microsoft",
      "installScript": null,
      "url": "https://learn.microsoft.com/powershell/scripting/install/install-ubuntu",
      "recommendedKeep": false,
      "notes": "Not in Mint's repos — needs Microsoft's package feed or a .deb from the PowerShell releases page.",
      "detectCommand": "command -v pwsh"
    },
    {
      "id": "visual-studio-code",
      "name": "Visual Studio Code",
      "category": "Dev Tools",
      "manager": "manual",
      "packageId": "code",
      "source": "microsoft",
      "installScript": null,
      "url": "https://code.visualstudio.com/download",
      "recommendedKeep": true,
      "notes": "Not in Mint's repos. Grab the .deb from the site (adds Microsoft's apt repo for updates) or install via the Software Manager flatpak.",
      "detectCommand": "command -v code"
    },
    {
      "id": "unity",
      "name": "Unity Hub",
      "category": "Dev Tools",
      "manager": "manual",
      "packageId": "unityhub",
      "source": "unity",
      "installScript": null,
      "url": "https://docs.unity3d.com/hub/manual/InstallHub.html",
      "recommendedKeep": false,
      "notes": "Needs Unity's apt repo + license sign-in — follow the Hub install docs.",
      "detectCommand": "command -v unityhub"
    },
    {
      "id": "blender",
      "name": "Blender",
      "category": "Media & Graphics",
      "manager": "apt",
      "packageId": "blender",
      "source": "apt",
      "installScript": "pkexec apt-get install -y blender",
      "url": null,
      "recommendedKeep": true,
      "notes": "Repo version trails blender.org releases; fine as a starter.",
      "detectCommand": "dpkg -s blender 2>/dev/null | grep -q 'ok installed'"
    },
    {
      "id": "gimp",
      "name": "GIMP",
      "category": "Media & Graphics",
      "manager": "apt",
      "packageId": "gimp",
      "source": "apt",
      "installScript": "pkexec apt-get install -y gimp",
      "url": null,
      "recommendedKeep": true,
      "notes": "The IrfanView stand-in.",
      "detectCommand": "dpkg -s gimp 2>/dev/null | grep -q 'ok installed'"
    },
    {
      "id": "vlc-media-player",
      "name": "VLC",
      "category": "Media & Graphics",
      "manager": "apt",
      "packageId": "vlc",
      "source": "apt",
      "installScript": "pkexec apt-get install -y vlc",
      "url": null,
      "recommendedKeep": true,
      "notes": "",
      "detectCommand": "dpkg -s vlc 2>/dev/null | grep -q 'ok installed'"
    },
    {
      "id": "7zip",
      "name": "7-Zip (p7zip)",
      "category": "Utilities",
      "manager": "apt",
      "packageId": "p7zip-full",
      "source": "apt",
      "installScript": "pkexec apt-get install -y p7zip-full",
      "url": null,
      "recommendedKeep": true,
      "notes": "",
      "detectCommand": "dpkg -s p7zip-full 2>/dev/null | grep -q 'ok installed'"
    },
    {
      "id": "chrome-remote-desktop-host",
      "name": "Chrome Remote Desktop",
      "category": "Remote Desktop",
      "manager": "deb",
      "packageId": "chrome-remote-desktop",
      "source": "google",
      "installScript": null,
      "downloadUrl": "https://dl.google.com/linux/direct/chrome-remote-desktop_current_amd64.deb",
      "url": "https://remotedesktop.google.com/access",
      "recommendedKeep": true,
      "notes": "Direct .deb download — Mint opens it in gdebi to install.",
      "detectCommand": "dpkg -s chrome-remote-desktop 2>/dev/null | grep -q 'ok installed'"
    },
    {
      "id": "parsec",
      "name": "Parsec",
      "category": "Remote Desktop",
      "manager": "deb",
      "packageId": "parsec",
      "source": "parsec",
      "installScript": null,
      "downloadUrl": "https://builds.parsec.app/package/parsec-linux.deb",
      "url": "https://parsec.app/downloads",
      "recommendedKeep": true,
      "notes": "Direct .deb download — Mint opens it in gdebi to install.",
      "detectCommand": "dpkg -s parsec 2>/dev/null | grep -q 'ok installed'"
    },
    {
      "id": "file-commander",
      "name": "File Commander",
      "category": "Utilities",
      "manager": "github",
      "packageId": "VioletGiraffe/file-commander",
      "source": "github-release",
      "installScript": null,
      "githubRepo": "VioletGiraffe/file-commander",
      "assetPattern": "*.AppImage",
      "url": "https://github.com/VioletGiraffe/file-commander/releases",
      "recommendedKeep": false,
      "notes": "Latest release AppImage into ~/Downloads. Caveat: AppImages need chmod +x before they run — see the Linux handoff doc.",
      "detectCommand": "ls \"$HOME/Downloads\"/FileCommander*.AppImage >/dev/null 2>&1"
    },
    {
      "id": "postman",
      "name": "Postman",
      "category": "Utilities",
      "manager": "manual",
      "packageId": "postman",
      "source": "postman",
      "installScript": null,
      "url": "https://www.postman.com/downloads/",
      "recommendedKeep": false,
      "notes": "Ships as a tarball (or flatpak via Software Manager) — no apt package.",
      "detectCommand": "command -v postman || [ -d /opt/Postman ]"
    },
    {
      "id": "free-download-manager",
      "name": "Free Download Manager",
      "category": "Utilities",
      "manager": "deb",
      "packageId": "freedownloadmanager",
      "source": "fdm",
      "installScript": null,
      "downloadUrl": "https://dl2.freedownloadmanager.org/6/latest/freedownloadmanager.deb",
      "url": "https://www.freedownloadmanager.org/download.htm",
      "recommendedKeep": false,
      "notes": "Direct .deb download — Mint opens it in gdebi to install.",
      "detectCommand": "dpkg -s freedownloadmanager 2>/dev/null | grep -q 'ok installed'"
    }
  ]
}
